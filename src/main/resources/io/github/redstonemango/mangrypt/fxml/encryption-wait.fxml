<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="root" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="271.0" prefWidth="490.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="io.github.redstonemango.mangrypt.front.controller.EncryptionWaitController">
    <children>
        <ImageView fx:id="background" fitHeight="301.0" fitWidth="490.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../image/alert_success.png" />
            </image>
        </ImageView>
        <FlowPane alignment="CENTER">
            <children>
                <AnchorPane prefHeight="267.0" prefWidth="485.0">
               <children>
                  <Label fx:id="title" layoutX="150.0" layoutY="34.0" prefWidth="186.0" styleClass="uncolored-label" text="Opening vault..." textAlignment="CENTER" underline="true">
                     <font>
                        <Font size="25.0" />
                     </font>
                  </Label>
                  <Label fx:id="content" layoutX="72.0" layoutY="79.0" prefHeight="49.0" prefWidth="341.0" styleClass="uncolored-label" text="Mangrypt is trying to decrypt your vault using the given password and passphrase." textAlignment="CENTER" wrapText="true">
